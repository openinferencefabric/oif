{
 "uid": "oif-scheduling",
 "title": "OIF Scheduling",
 "description": "GPUs offered, in use and waiting per vendor; Run:ai project quotas; per-vendor caps (ADR-015).",
 "tags": [
  "oif"
 ],
 "editable": true,
 "schemaVersion": 41,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "browser",
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "vendor",
    "label": "Vendor",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(oif:gpu_allocatable, vendor)",
     "refId": "vendor"
    },
    "definition": "label_values(oif:gpu_allocatable, vendor)",
    "includeAll": true,
    "multi": true,
    "allValue": ".*",
    "refresh": 2,
    "sort": 1,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "annotations": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "GPUs by vendor",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Allocatable",
   "description": "GPUs the nodes offer to Kubernetes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (vendor) (oif:gpu_allocatable{vendor=~\"$vendor\"})",
     "legendFormat": "{{vendor}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "#8a8f8c"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "/^nvidia.*/"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#76B900"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "/^amd.*/"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ED1C24"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "orientation": "horizontal"
   }
  },
