+package gpusharingnodevalidation
+
+import (
+	"testing"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+
+	kaiv1common "github.com/kai-scheduler/KAI-scheduler/pkg/apis/kai/v1/common"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/scheduler/api/pod_info"
+)
+
+// oif patch (T-126): a fraction on an AMD GPU node needs no gpu-fractioning condition; NVIDIA nodes still do.
+func TestOifAmdNodeSkipsNvFractionsReadyCondition(t *testing.T) {
+	task := &pod_info.PodInfo{Name: "shared-pod", Namespace: "ns", ResourceRequestType: pod_info.RequestTypeFraction}
+	nvMode := isNvFractionsMode(newSessionWithMode(kaiv1common.GpuSharingModeNvFractions))
+
+	amd := newNode("gpu-amd")
+	amd.Node.Status.Allocatable = v1.ResourceList{"amd.com/gpu": resource.MustParse("1")}
+	if err := checkNvFractionalGPUReadyCondition(task, amd, nvMode); err != nil {
+		t.Errorf("AMD node refused: %v", err)
+	}
+
+	nv := newNode("gpu-nvidia")
+	nv.Node.Status.Allocatable = v1.ResourceList{"nvidia.com/gpu": resource.MustParse("1")}
+	if err := checkNvFractionalGPUReadyCondition(task, nv, nvMode); err == nil {
+		t.Errorf("NVIDIA node without the gpu-fractioning condition accepted")
+	}
+}
