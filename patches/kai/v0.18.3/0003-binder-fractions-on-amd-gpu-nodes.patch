+package resourcereservation
+
+import (
+	"context"
+
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"sigs.k8s.io/controller-runtime/pkg/client/fake"
+
+	schedulingv1alpha2 "github.com/kai-scheduler/KAI-scheduler/pkg/apis/scheduling/v1alpha2"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/common/constants"
+)
+
+// oif patch (T-126): on an AMD GPU node the reservation pod holds an amd.com/gpu.
+var _ = Describe("oif: GPU reservation pod on an AMD GPU node", func() {
+	It("requests amd.com/gpu and no nvidia.com/gpu", func() {
+		node := &v1.Node{
+			ObjectMeta: metav1.ObjectMeta{Name: "gpu-amd"},
+			Status:     v1.NodeStatus{Allocatable: v1.ResourceList{"amd.com/gpu": resource.MustParse("1")}},
+		}
+		rsc := &service{
+			namespace:           "kai-resource-reservation",
+			appLabelValue:       "kai-reservation",
+			serviceAccountName:  "kai-sa",
+			reservationPodImage: "test-image:latest",
+			kubeClient:          fake.NewClientBuilder().WithScheme(testScheme).WithObjects(node).Build(),
+			podResources: &v1.ResourceRequirements{Limits: v1.ResourceList{
+				constants.NvidiaGpuResource: resource.MustParse("1"), v1.ResourceCPU: resource.MustParse("100m")}},
+			scalingPodNamespace: scalingPodsNamespace,
+		}
+		pod, err := rsc.createGPUReservationPod(context.TODO(), nil, "gpu-amd", schedulingv1alpha2.FractionalGpuGroup{
+			ID: "g1", ComputeSharingMode: schedulingv1alpha2.GPUComputeSharingModeTimeSlicing,
+		})
+		Expect(err).To(BeNil())
+		r := pod.Spec.Containers[0].Resources
+		amd := r.Limits["amd.com/gpu"]
+		Expect(amd.Value()).To(Equal(int64(1)))
+		Expect(r.Limits).NotTo(HaveKey(v1.ResourceName(constants.NvidiaGpuResource)))
+		Expect(r.Requests).NotTo(HaveKey(v1.ResourceName(constants.NvidiaGpuResource)))
+		Expect(r.Limits).To(HaveKey(v1.ResourceCPU))
+		Expect(rsc.podResources.Limits).To(HaveKey(v1.ResourceName(constants.NvidiaGpuResource)), "the shared config is not changed")
+	})
+})
