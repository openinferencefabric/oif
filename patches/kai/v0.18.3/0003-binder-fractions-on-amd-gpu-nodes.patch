 }
 
+// setOifAmdShareAnnotations (oif patch, T-126): on an AMD GPU node the reserved GPU id is the GPU's PCI address
+// (reported by the reservation pod); oif's NRI plugin gives the container that GPU. No driver limits its memory:
+// the share is passed on for the workload to respect (OIF_GPU_MEMORY_FRACTION).
+func setOifAmdShareAnnotations(bindRequest *v1alpha2.BindRequest, containerName string, bindingState *state.BindingState) error {
+	if len(bindingState.ReservedGPUIds) != 1 {
+		return fmt.Errorf("oif: a pod shares one AMD GPU, got %d reserved", len(bindingState.ReservedGPUIds))
+	}
+	if bindRequest == nil || bindRequest.Spec.ReceivedGPU == nil {
+		return fmt.Errorf("missing received GPU portion for the AMD GPU share")
+	}
+	portion, err := strconv.ParseFloat(bindRequest.Spec.ReceivedGPU.Portion, 64)
+	if err != nil || portion <= 0 || portion > 1 {
+		return fmt.Errorf("invalid received gpu portion %q", bindRequest.Spec.ReceivedGPU.Portion)
+	}
+	bindingState.BindingPodAnnotations[resources.OifAmdGpuAnnotation] = bindingState.ReservedGPUIds[0]
+	bindingState.BindingPodAnnotations[resources.OifAmdGpuContainerAnnotation] = containerName
+	bindingState.BindingPodAnnotations[resources.OifAmdGpuFractionAnnotation] = strconv.FormatFloat(portion, 'f', -1, 64)
+	return nil
+}
