@@ -0,0 +1,56 @@
+package nvfractions
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/apis/scheduling/v1alpha2"
+	bindercommon "github.com/kai-scheduler/KAI-scheduler/pkg/binder/common"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/binder/plugins/state"
+	"github.com/kai-scheduler/KAI-scheduler/pkg/common/resources"
+)
+
+func oifAmdCase(portion string, ids ...string) (*v1.Pod, *v1.Node, *v1alpha2.BindRequest, *state.BindingState) {
+	pod := &v1.Pod{
+		ObjectMeta: metav1.ObjectMeta{Annotations: map[string]string{}},
+		Spec:       v1.PodSpec{Containers: []v1.Container{{Name: "main"}}},
+	}
+	node := &v1.Node{Status: v1.NodeStatus{Allocatable: v1.ResourceList{"amd.com/gpu": resource.MustParse("1")}}}
+	br := &v1alpha2.BindRequest{Spec: v1alpha2.BindRequestSpec{
+		ReceivedResourceType: bindercommon.ReceivedTypeFraction,
+		ReceivedGPU:          &v1alpha2.ReceivedGPU{Portion: portion},
+	}}
+	return pod, node, br, &state.BindingState{ReservedGPUIds: ids}
+}
+
+// oif patch (T-126): on an AMD GPU node the binder names the GPU for oif's NRI plugin instead of NVIDIA's annotations.
+func TestOifPreBindAmdNode(t *testing.T) {
+	pod, node, br, st := oifAmdCase("0.5", "0000:03:00.0")
+	assert.NoError(t, New(false).PreBind(context.Background(), pod, node, br, st))
+	a := st.BindingPodAnnotations
+	assert.Equal(t, "0000:03:00.0", a[resources.OifAmdGpuAnnotation])
+	assert.Equal(t, "main", a[resources.OifAmdGpuContainerAnnotation])
+	assert.Equal(t, "0.5", a[resources.OifAmdGpuFractionAnnotation])
+	assert.Empty(t, a[resources.CalcGpuVisibleDevicesAnnotationForContainer("main")], "no NVIDIA visible devices on an AMD node")
+	assert.Empty(t, a[resources.CalcGpuFractionAnnotationForContainer("main")], "no NVIDIA memory request on an AMD node")
+}
+
+func TestOifPreBindAmdNodeRefused(t *testing.T) {
+	for name, c := range map[string]struct {
+		portion string
+		ids     []string
+	}{
+		"two GPUs":     {"0.5", []string{"0000:03:00.0", "0000:04:00.0"}},
+		"no GPU":       {"0.5", nil},
+		"bad portion":  {"x", []string{"0000:03:00.0"}},
+		"zero portion": {"0", []string{"0000:03:00.0"}},
+	} {
+		pod, node, br, st := oifAmdCase(c.portion, c.ids...)
+		assert.Error(t, New(false).PreBind(context.Background(), pod, node, br, st), name)
+	}
+}
