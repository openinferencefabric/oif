diff --git a/pkg/common/resources/oif_amd_gpu.go b/pkg/common/resources/oif_amd_gpu.go
new file mode 100644
index 0000000..fa04bcf
--- /dev/null
+++ b/pkg/common/resources/oif_amd_gpu.go
@@ -0,0 +1,37 @@
+// oif patch (open-inference-fabric T-126, ADR-032): GPU fractions on AMD GPUs. KAI's fraction path is written for
+// NVIDIA; on a node whose GPUs are AMD, the reservation pod holds an amd.com/gpu and oif's NRI plugin gives the
+// fractional pod that GPU (named by the annotations below), with soft memory isolation.
+
+package resources
+
+import (
+	v1 "k8s.io/api/core/v1"
+
+	"github.com/kai-scheduler/KAI-scheduler/pkg/common/constants"
+)
+
+const (
+	AmdGpuResource = v1.ResourceName("amd.com/gpu")
+
+	// Written by the binder, read by oif's NRI plugin (oif-amd-share); only the binder may set them.
+	OifAmdGpuAnnotation          = "oif.ai/amd-gpu"           // PCI address of the shared GPU
+	OifAmdGpuContainerAnnotation = "oif.ai/amd-gpu-container" // the container that gets it
+	OifAmdGpuFractionAnnotation  = "oif.ai/amd-gpu-fraction"  // the share of the GPU
+)
+
+// IsAmdGpuNode: the node offers amd.com/gpu and no nvidia.com/gpu.
+func IsAmdGpuNode(node *v1.Node) bool {
+	if node == nil {
+		return false
+	}
+	amd, nv := node.Status.Allocatable[AmdGpuResource], node.Status.Allocatable[constants.NvidiaGpuResource]
+	return amd.Value() > 0 && nv.Value() == 0
+}
+
+// GpuResourceOfNode is the extended resource that holds a whole GPU on the node.
+func GpuResourceOfNode(node *v1.Node) v1.ResourceName {
+	if IsAmdGpuNode(node) {
+		return AmdGpuResource
+	}
+	return constants.NvidiaGpuResource
+}
diff --git a/pkg/common/resources/oif_amd_gpu_test.go b/pkg/common/resources/oif_amd_gpu_test.go
new file mode 100644
index 0000000..99e3f2c
--- /dev/null
+++ b/pkg/common/resources/oif_amd_gpu_test.go
@@ -0,0 +1,41 @@
+package resources
+
+import (
+	"testing"
+
+	v1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+)
+
+func oifNode(res map[v1.ResourceName]string) *v1.Node {
+	n := &v1.Node{Status: v1.NodeStatus{Allocatable: v1.ResourceList{}}}
+	for r, q := range res {
+		n.Status.Allocatable[r] = resource.MustParse(q)
+	}
+	return n
+}
+
+func TestOifAmdGpuNode(t *testing.T) {
+	for name, c := range map[string]struct {
+		node *v1.Node
+		amd  bool
+	}{
+		"amd":         {oifNode(map[v1.ResourceName]string{"amd.com/gpu": "1"}), true},
+		"nvidia":      {oifNode(map[v1.ResourceName]string{"nvidia.com/gpu": "1"}), false},
+		"both":        {oifNode(map[v1.ResourceName]string{"amd.com/gpu": "1", "nvidia.com/gpu": "1"}), false},
+		"cpu only":    {oifNode(nil), false},
+		"amd, 0 left": {oifNode(map[v1.ResourceName]string{"amd.com/gpu": "0"}), false},
+		"nil":         {nil, false},
+	} {
+		if got := IsAmdGpuNode(c.node); got != c.amd {
+			t.Errorf("%s: IsAmdGpuNode = %v", name, got)
+		}
+		want := v1.ResourceName("nvidia.com/gpu")
+		if c.amd {
+			want = AmdGpuResource
+		}
+		if got := GpuResourceOfNode(c.node); got != want {
+			t.Errorf("%s: GpuResourceOfNode = %s", name, got)
+		}
+	}
+}
