+    oifVendorCompute(vendor: string, compute: IUISuperWorkloadSpec["compute"]): IUISuperWorkloadSpec["compute"] {
+      const c = { ...compute };
+      const others = (c.extendedResources || []).filter((e) => e.resource !== AMD_GPU);
+      // whole GPUs: no request type, or a portion of 1 (how Run:ai stores a whole GPU in a compute resource)
+      const whole = (c.gpuDevicesRequest || 0) > 0 &&
+        (!c.gpuRequestType || (c.gpuRequestType === "portion" && (c.gpuPortionRequest || 0) >= 1));
