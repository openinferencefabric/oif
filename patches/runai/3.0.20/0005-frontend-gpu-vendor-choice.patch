+  // oif patch (open-inference-fabric T-140): GPU vendor choice
+  describe("oif GPU vendor", () => {
+    const pools = [{ value: "nvidia" }, { value: "amd" }, { value: "default" }];
+    const cpu = { request: 1, limit: null };
+    const mem = { request: "1G", limit: null };
+    const last = (w: ReturnType<typeof factory>) => w.emitted("update")?.slice(-1)[0]?.[0] as Record<string, any>;
+
+    it("offers the vendors whose pools the project has", () => {
+      expect(factory({ nodePoolsResources: pools }).vm.vendorOptions.map((o: { value: string }) => o.value)).toEqual(["nvidia", "amd", "none"]);
+      expect(factory({ nodePoolsResources: [{ value: "default" }] }).vm.vendorOptions).toEqual([]);
+    });
+
+    it("AMD with whole GPUs: pool amd and amd.com/gpu instead of GPU devices", async () => {
+      const w = factory({ nodePoolsResources: pools, workloadSpec: { nodePools: ["nvidia", "amd"], compute: { gpuDevicesRequest: 2 } } });
+      await w.vm.selectVendor("amd");
+      expect(last(w).nodePools).toEqual(["amd"]);
+      expect(last(w).compute.gpuDevicesRequest).toBe(0);
+      expect(last(w).compute.extendedResources).toEqual([{ resource: "amd.com/gpu", quantity: "2" }]);
+    });
+
+    it("AMD with a whole-GPU compute resource (portion 1): amd.com/gpu, no fraction", async () => {
+      const w = factory({ nodePoolsResources: pools,
+        workloadSpec: { nodePools: ["amd"], compute: { gpuDevicesRequest: 1, gpuRequestType: "portion", gpuPortionRequest: 1 } } });
+      await w.vm.selectVendor("amd");
+      expect(last(w).compute.extendedResources).toEqual([{ resource: "amd.com/gpu", quantity: "1" }]);
+      expect(last(w).compute.gpuDevicesRequest).toBe(0);
+      expect(last(w).compute.gpuRequestType).toBeUndefined();
+    });
+
+    it("shows whole AMD GPUs in the GPU devices field and reads the vendor back", () => {
+      const w = factory({ nodePoolsResources: pools,
+        workloadSpec: { nodePools: ["amd"], compute: { gpuDevicesRequest: 0, extendedResources: [{ resource: "amd.com/gpu", quantity: "1" }] } } });
+      expect(w.vm.resourcesModel.gpuDevicesRequest).toBe(1);
+      expect(w.vm.gpuVendor).toBe("amd");
+    });
+
+    it("AMD fraction: GPU devices and portion kept, no amd.com/gpu", async () => {
+      const w = factory({ nodePoolsResources: pools,
+        workloadSpec: { nodePools: ["amd"], compute: { gpuDevicesRequest: 0, extendedResources: [{ resource: "amd.com/gpu", quantity: "1" }] } } });
+      await w.vm.updateResourcesModel({ gpuDevicesRequest: 1, gpuRequestType: "portion", gpuPortionRequest: 0.5, cpuCore: cpu, cpuMemory: mem });
+      expect(last(w).compute.gpuDevicesRequest).toBe(1);
+      expect(last(w).compute.gpuPortionRequest).toBe(0.5);
+      expect(last(w).compute.extendedResources).toEqual([]);
+    });
+
+    it("back to NVIDIA: whole AMD GPUs become GPU devices, other extended resources stay", async () => {
+      const w = factory({ nodePoolsResources: pools, workloadSpec: { nodePools: ["amd"],
+        compute: { gpuDevicesRequest: 0, extendedResources: [{ resource: "amd.com/gpu", quantity: "1" }, { resource: "example.com/x", quantity: "1" }] } } });
+      await w.vm.selectVendor("nvidia");
+      expect(last(w).nodePools).toEqual(["nvidia"]);
+      expect(last(w).compute.gpuDevicesRequest).toBe(1);
+      expect(last(w).compute.extendedResources).toEqual([{ resource: "example.com/x", quantity: "1" }]);
+    });
+
+    it("No GPU: pool default, GPU request cleared", async () => {
+      const w = factory({ nodePoolsResources: pools, workloadSpec: { nodePools: ["nvidia"], compute: { gpuDevicesRequest: 1, gpuRequestType: "portion", gpuPortionRequest: 0.5 } } });
+      await w.vm.selectVendor("none");
+      expect(last(w).nodePools).toEqual(["default"]);
+      expect(last(w).compute.gpuDevicesRequest).toBe(0);
+      expect(last(w).compute.gpuPortionRequest).toBeUndefined();
+    });
+  });
