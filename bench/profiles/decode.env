# oif bench profile "decode" (B-3a): generation across answer lengths for Qwen3-0.6B. A 128-token prompt, so almost all
# of each request is decode; the trace pass splits inter-token latency into engine step, output path and API layer.
# 120 s points: a 2048-token answer takes up to about 80 s at 32 users (4096 tokens did not end inside 60 s + 60 s in
# the calibration). No prefix cache: AIPerf reuses its prompts. Qwen3-8B: profile decode-8b.
BENCH_WORKLOADS="d256:128:256 d1k:128:1024 d2k:128:2048"
BENCH_CONCURRENCY="1 8 32 64"
BENCH_DURATION_S=120
BENCH_REPEATS=3
BENCH_PREFIX_CACHE=off
