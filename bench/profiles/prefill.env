# oif bench profile "prefill" (B-3a): prompt processing across prompt lengths for Qwen3-0.6B. 16 output tokens, so the
# first token is most of each request; the trace pass splits TTFT into queue, prefill, output path and API layer.
# Prompts up to 8K need a context above the default 8192. Qwen3-8B: profile prefill-8b (its prefill is too slow for
# 64 users of 8K prompts in a 60 s point).
BENCH_WORKLOADS="p1k:1024:16 p4k:4096:16 p8k:8192:16"
# 1 to 16 users: the 4K and 8K prompts reach the prompt rate by 8 users and 1K by 32 (calibration 02); beyond that
# TTFT is only queue.
BENCH_CONCURRENCY="1 4 8 16"
BENCH_DURATION_S=60
BENCH_REPEATS=1  # one repeat throughout (owner, 2026-11-27): per-request spread instead of a run-to-run verdict
BENCH_CTX=16384
# No prefix cache: AIPerf reuses 100 prompts, and a warm cache served 99% of the 1K-prompt tokens in the calibration.
BENCH_PREFIX_CACHE=off
