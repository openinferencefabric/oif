# oif bench profile "prefill-8b" (B-3a): profile prefill for Qwen3-8B, at concurrencies its prefill can serve within a
# 60 s point (about 8 users of 8K prompts).
BENCH_WORKLOADS="p1k:1024:16 p4k:4096:16 p8k:8192:16"
BENCH_CONCURRENCY="1 2 4 8"
BENCH_DURATION_S=60
BENCH_REPEATS=1  # one repeat throughout (owner, 2026-11-27): per-request spread instead of a run-to-run verdict
BENCH_CTX=16384
# No prefix cache: AIPerf reuses 100 prompts, and a warm cache served 99% of the 1K-prompt tokens in the calibration.
BENCH_PREFIX_CACHE=off
