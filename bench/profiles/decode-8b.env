# oif bench profile "decode-8b" (B-3a): profile decode for Qwen3-8B, up to 32 users. At 32 users a token takes about
# 40 ms on the W7900, so a 2048-token answer ends in about 80 s, inside the 120 s point.
BENCH_WORKLOADS="d256:128:256 d1k:128:1024 d2k:128:2048"
BENCH_CONCURRENCY="1 8 16 32"
BENCH_DURATION_S=120
BENCH_REPEATS=1  # one repeat throughout (owner, 2026-11-27): per-request spread instead of a run-to-run verdict
BENCH_PREFIX_CACHE=off
