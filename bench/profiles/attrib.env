# oif bench profile "attrib" (B-1b): the points where Dynamo's first token came sooner in B-1 (chat and short prompts,
# 8 to 64 users) and one user as the control. Run it twice: once plain (timings, 3 repeats), once with --trace
# --repeats 1 (where the time goes; profiling slows the server). Qwen3-0.6B: about 40 min per stack per pass.
BENCH_WORKLOADS="chat:512:256 short:128:128"
BENCH_CONCURRENCY="1 8 16 32 64"
BENCH_DURATION_S=60
BENCH_REPEATS=3
